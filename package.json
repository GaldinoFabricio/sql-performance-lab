{
   "name": "sql-performance-lab",
   "version": "1.0.0",
   "description": "",
   "main": "index.js",
   "scripts": {
      "test": "vitest run",
      "test:watch": "vitest",
      "build": "tsc -p .",
      "start": "node dist/server.js",
      "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
      "migrate": "knex --knexfile src/knexfile.ts migrate:latest",
      "migrate:rollback": "knex --knexfile src/knexfile.ts migrate:rollback",
      "migrate:make": "knex --knexfile src/knexfile.ts migrate:make",
      "seed:make": "knex --knexfile src/knexfile.ts seed:make",
      "seed:run": "knex --knexfile src/knexfile.ts seed:run",
      "seed:logs": "knex --knexfile src/knexfile.ts seed:run --specific=seed_logs.ts",
      "model:fetch": "ts-node --transpile-only src/scripts/model.ts fetch",
      "model:verify": "ts-node --transpile-only src/scripts/model.ts verify",
      "embed:logs": "ts-node --transpile-only src/scripts/embed-logs.ts",
      "templates:build": "ts-node --transpile-only src/scripts/templates-build.ts",
      "eval:ground-truth": "ts-node --transpile-only src/scripts/ground-truth.ts",
      "eval:search": "ts-node --transpile-only src/scripts/search-experiments.ts",
      "eval:report": "ts-node --transpile-only src/scripts/search-report.ts",
      "eval:plans": "ts-node --transpile-only src/scripts/plan-experiments.ts",
      "eval:hnsw-dive": "ts-node --transpile-only src/scripts/hnsw-dive.ts",
      "eval:templates": "ts-node --transpile-only src/scripts/templates-eval.ts",
      "eval:partial-hnsw": "ts-node --transpile-only src/scripts/partial-hnsw.ts"
   },
   "keywords": [],
   "author": "",
   "license": "ISC",
   "packageManager": "pnpm@10.22.0",
   "dependencies": {
      "@huggingface/transformers": "4.3.2",
      "celebrate": "^16.0.0",
      "dotenv": "^17.3.1",
      "express": "^5.2.1",
      "knex": "^3.2.7",
      "pg": "^8.20.0"
   },
   "devDependencies": {
      "@faker-js/faker": "^10.4.0",
      "@types/express": "^5.0.6",
      "@types/node": "^25.5.0",
      "@types/supertest": "^7.2.0",
      "supertest": "^7.2.2",
      "ts-node": "^10.9.2",
      "ts-node-dev": "^2.0.0",
      "typescript": "^6.0.2",
      "vitest": "^4.1.2"
   },
   "vitest": {
      "environment": "node"
   },
   "pnpm": {
      "ignoredBuiltDependencies": [
         "onnxruntime-node",
         "protobufjs"
      ]
   }
}
